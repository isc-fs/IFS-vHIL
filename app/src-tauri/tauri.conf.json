{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ISC vHIL",
  "version": "../package.json",
  "identifier": "org.iscfs.vhil",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ISC vHIL",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Virtual hardware-in-the-loop bench",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/isc-fs/iskapps/main/vhil/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJERDE5RDIzMjY1QTIyMjIKUldRaUlsb21JNTNSdlcva0ovMDRwVkVUWldXVTFNYnVMT1krWk1udTlzZ0RCUVVRODJDQ2IxQ0gK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
